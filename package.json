{
  "name": "yadam-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "studio": "remotion studio src/remotion/index.ts --no-open",
    "render:demo": "remotion render src/remotion/index.ts YadamPreview out/demo.mp4"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/captions": "4.0.534",
    "@remotion/player": "4.0.534",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.534",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.534",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "jsdom": "^27.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.12"
  },
  "packageManager": "pnpm@10.20.0"
}
